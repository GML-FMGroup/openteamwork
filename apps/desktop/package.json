{
  "name": "@openppx/desktop",
  "version": "0.5.2",
  "private": true,
  "description": "Local-first desktop workbench for OpenPPX agents",
  "author": "OpenPPX Contributors",
  "license": "Apache-2.0",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run verify:preload",
    "preview": "vite preview",
    "test": "vitest run && npm run test:preload",
    "test:preload": "node --test scripts/verify-preload.node-test.mjs",
    "package": "npm run build && electron-builder --mac --arm64 --publish never && npm run verify:package",
    "package:dir": "npm run build && electron-builder --dir --mac --arm64 && npm run verify:package",
    "verify:preload": "node scripts/verify-preload.mjs dist-electron/preload/index.cjs",
    "verify:package": "node scripts/verify-preload.mjs --asar \"release/mac-arm64/OpenPPX Desktop.app/Contents/Resources/app.asar\" dist-electron/preload/index.cjs",
    "checksum": "node scripts/checksum-release.mjs"
  },
  "dependencies": {
    "@openppx/client": "workspace:*"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^40.0.0",
    "electron-builder": "26.15.3",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.30.3"
}
