{
  "$defs": {
    "ActionCatalogItem": {
      "additionalProperties": false,
      "description": "Client-safe Action metadata and caller-specific availability.",
      "properties": {
        "actionId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Actionid",
          "type": "string"
        },
        "availabilityReason": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Availabilityreason"
        },
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "confirmation": {
          "enum": [
            "never",
            "required"
          ],
          "title": "Confirmation",
          "type": "string"
        },
        "description": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "execution": {
          "enum": [
            "sync",
            "long_running"
          ],
          "title": "Execution",
          "type": "string"
        },
        "inputSchema": {
          "additionalProperties": true,
          "title": "Inputschema",
          "type": "object"
        },
        "namespace": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "operation": {
          "default": "read",
          "enum": [
            "read",
            "mutation"
          ],
          "title": "Operation",
          "type": "string"
        },
        "permission": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Permission",
          "type": "string"
        },
        "previewActionId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previewactionid"
        },
        "projections": {
          "items": {
            "enum": [
              "cli",
              "slash",
              "desktop",
              "mobile"
            ],
            "type": "string"
          },
          "title": "Projections",
          "type": "array"
        },
        "requiredCapabilities": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Requiredcapabilities",
          "type": "array"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "scope": {
          "enum": [
            "node",
            "agent",
            "session",
            "run",
            "task",
            "goal",
            "flow",
            "automation",
            "extension"
          ],
          "title": "Scope",
          "type": "string"
        },
        "slashCommands": {
          "items": {
            "$ref": "#/$defs/SlashCommandItem"
          },
          "title": "Slashcommands",
          "type": "array"
        },
        "successPresentation": {
          "default": "inline",
          "enum": [
            "inline",
            "panel",
            "navigate",
            "toast"
          ],
          "title": "Successpresentation",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "actionId",
        "namespace",
        "title",
        "description",
        "scope",
        "inputSchema",
        "requiredCapabilities",
        "permission",
        "risk",
        "confirmation",
        "execution",
        "projections",
        "available"
      ],
      "title": "ActionCatalogItem",
      "type": "object"
    },
    "ActionCatalogPayload": {
      "additionalProperties": false,
      "description": "Caller-aware Action catalog result.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ActionCatalogItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "ActionCatalogPayload",
      "type": "object"
    },
    "ActionInvokeRequest": {
      "additionalProperties": false,
      "description": "Transport-neutral Action invocation request body.",
      "properties": {
        "actionId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Actionid",
          "type": "string"
        },
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "correlationId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Correlationid",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Requestid",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "correlationId",
        "actionId"
      ],
      "title": "ActionInvokeRequest",
      "type": "object"
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "description": "Failed common response envelope.",
      "properties": {
        "correlationId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Correlationid",
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/StableError"
        },
        "ok": {
          "const": false,
          "title": "Ok",
          "type": "boolean"
        },
        "protocolVersion": {
          "minimum": 1,
          "title": "Protocolversion",
          "type": "integer"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Requestid",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "correlationId",
        "ok",
        "error"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    },
    "ExtensionDetailPayload": {
      "additionalProperties": false,
      "description": "One Extension row plus bounded domain-specific fields.",
      "properties": {
        "description": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "displayName": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Displayname",
          "type": "string"
        },
        "enabledAgentIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Enabledagentids",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "plugin",
            "app",
            "mcp",
            "skill"
          ],
          "title": "Kind",
          "type": "string"
        },
        "managedBy": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Managedby"
        },
        "presentation": {
          "$ref": "#/$defs/ExtensionPresentation"
        },
        "readiness": {
          "$ref": "#/$defs/ExtensionReadiness"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ExtensionSourceSummary"
        },
        "status": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "displayName",
        "description",
        "version",
        "status",
        "revision",
        "source",
        "risk",
        "readiness",
        "presentation",
        "details"
      ],
      "title": "ExtensionDetailPayload",
      "type": "object"
    },
    "ExtensionListPayload": {
      "additionalProperties": false,
      "description": "Unified Extension inventory result.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ExtensionSummaryItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "ExtensionListPayload",
      "type": "object"
    },
    "ExtensionPresentation": {
      "additionalProperties": false,
      "description": "Client-safe Extension icon identity without remote image data.",
      "properties": {
        "brandColor": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brandcolor"
        },
        "icon": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Icon",
          "type": "string"
        }
      },
      "required": [
        "icon"
      ],
      "title": "ExtensionPresentation",
      "type": "object"
    },
    "ExtensionPreviewPayload": {
      "additionalProperties": false,
      "description": "Confirmed source digest and client-safe install preview.",
      "properties": {
        "kind": {
          "enum": [
            "plugin",
            "skill"
          ],
          "title": "Kind",
          "type": "string"
        },
        "preview": {
          "additionalProperties": true,
          "title": "Preview",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "preview"
      ],
      "title": "ExtensionPreviewPayload",
      "type": "object"
    },
    "ExtensionReadiness": {
      "additionalProperties": false,
      "description": "Common Extension readiness without backend exception or Secret material.",
      "properties": {
        "issues": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "ready": {
          "title": "Ready",
          "type": "boolean"
        }
      },
      "required": [
        "ready"
      ],
      "title": "ExtensionReadiness",
      "type": "object"
    },
    "ExtensionSourceSummary": {
      "additionalProperties": false,
      "description": "Non-sensitive Extension provenance category and trust posture.",
      "properties": {
        "trust": {
          "enum": [
            "builtin",
            "local",
            "third_party"
          ],
          "title": "Trust",
          "type": "string"
        },
        "type": {
          "enum": [
            "builtin",
            "local_directory",
            "local_archive",
            "git",
            "catalog",
            "direct",
            "plugin"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "trust"
      ],
      "title": "ExtensionSourceSummary",
      "type": "object"
    },
    "ExtensionSummaryItem": {
      "additionalProperties": false,
      "description": "One stable row in the unified four-kind Extension inventory.",
      "properties": {
        "description": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "displayName": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Displayname",
          "type": "string"
        },
        "enabledAgentIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Enabledagentids",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "plugin",
            "app",
            "mcp",
            "skill"
          ],
          "title": "Kind",
          "type": "string"
        },
        "managedBy": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Managedby"
        },
        "presentation": {
          "$ref": "#/$defs/ExtensionPresentation"
        },
        "readiness": {
          "$ref": "#/$defs/ExtensionReadiness"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Risk",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ExtensionSourceSummary"
        },
        "status": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "displayName",
        "description",
        "version",
        "status",
        "revision",
        "source",
        "risk",
        "readiness",
        "presentation"
      ],
      "title": "ExtensionSummaryItem",
      "type": "object"
    },
    "SlashCommandArgumentItem": {
      "additionalProperties": false,
      "description": "One typed positional argument projected to all command clients.",
      "properties": {
        "choices": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        },
        "description": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "valueType": {
          "enum": [
            "string",
            "text",
            "integer",
            "boolean",
            "enum",
            "resource_id"
          ],
          "title": "Valuetype",
          "type": "string"
        }
      },
      "required": [
        "name",
        "valueType",
        "description"
      ],
      "title": "SlashCommandArgumentItem",
      "type": "object"
    },
    "SlashCommandInvokeInput": {
      "additionalProperties": false,
      "description": "Structured context for the shared command invocation Action.",
      "properties": {
        "agentId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agentid"
        },
        "rawCommand": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Rawcommand",
          "type": "string"
        },
        "runId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runid"
        },
        "sessionId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sessionid"
        },
        "userId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Userid",
          "type": "string"
        }
      },
      "required": [
        "rawCommand",
        "userId"
      ],
      "title": "SlashCommandInvokeInput",
      "type": "object"
    },
    "SlashCommandInvokeResult": {
      "additionalProperties": false,
      "description": "Structured command outcome retaining target Action provenance.",
      "properties": {
        "command": {
          "pattern": "^/[a-z][a-z0-9-]*$",
          "title": "Command",
          "type": "string"
        },
        "lifecycle": {
          "enum": [
            "side_channel",
            "finalize_active_turn",
            "stop_active_turn",
            "agent_turn"
          ],
          "title": "Lifecycle",
          "type": "string"
        },
        "result": {
          "additionalProperties": true,
          "title": "Result",
          "type": "object"
        },
        "targetActionId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Targetactionid",
          "type": "string"
        }
      },
      "required": [
        "command",
        "lifecycle",
        "targetActionId",
        "result"
      ],
      "title": "SlashCommandInvokeResult",
      "type": "object"
    },
    "SlashCommandItem": {
      "additionalProperties": false,
      "description": "Client-safe command alias projected from one Action.",
      "properties": {
        "acceptsArgs": {
          "default": false,
          "title": "Acceptsargs",
          "type": "boolean"
        },
        "argHint": {
          "default": "",
          "maxLength": 120,
          "title": "Arghint",
          "type": "string"
        },
        "arguments": {
          "items": {
            "$ref": "#/$defs/SlashCommandArgumentItem"
          },
          "title": "Arguments",
          "type": "array"
        },
        "command": {
          "pattern": "^/[a-z][a-z0-9-]*$",
          "title": "Command",
          "type": "string"
        },
        "description": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "icon": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Icon",
          "type": "string"
        },
        "lifecycle": {
          "enum": [
            "side_channel",
            "finalize_active_turn",
            "stop_active_turn",
            "agent_turn"
          ],
          "title": "Lifecycle",
          "type": "string"
        },
        "noArgsBehavior": {
          "default": "invoke",
          "enum": [
            "invoke",
            "show_usage"
          ],
          "title": "Noargsbehavior",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "usage": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Usage",
          "type": "string"
        }
      },
      "required": [
        "command",
        "title",
        "description",
        "icon",
        "lifecycle",
        "usage",
        "order"
      ],
      "title": "SlashCommandItem",
      "type": "object"
    },
    "StableError": {
      "additionalProperties": false,
      "description": "Redacted stable error shared by HTTP and future transports.",
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "StableError",
      "type": "object"
    },
    "SuccessEnvelope": {
      "additionalProperties": false,
      "description": "Successful common response envelope.",
      "properties": {
        "correlationId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Correlationid",
          "type": "string"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "protocolVersion": {
          "minimum": 1,
          "title": "Protocolversion",
          "type": "integer"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Requestid",
          "type": "string"
        },
        "result": {
          "additionalProperties": true,
          "title": "Result",
          "type": "object"
        }
      },
      "required": [
        "protocolVersion",
        "requestId",
        "correlationId",
        "ok",
        "result"
      ],
      "title": "SuccessEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Schema-only root that retains every Increment 3 contract definition.",
  "properties": {
    "actionCatalog": {
      "$ref": "#/$defs/ActionCatalogPayload"
    },
    "actionInvoke": {
      "$ref": "#/$defs/ActionInvokeRequest"
    },
    "envelope": {
      "discriminator": {
        "mapping": {
          "False": "#/$defs/ErrorEnvelope",
          "True": "#/$defs/SuccessEnvelope"
        },
        "propertyName": "ok"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SuccessEnvelope"
        },
        {
          "$ref": "#/$defs/ErrorEnvelope"
        }
      ],
      "title": "Envelope"
    },
    "extensionDetail": {
      "$ref": "#/$defs/ExtensionDetailPayload"
    },
    "extensionList": {
      "$ref": "#/$defs/ExtensionListPayload"
    },
    "extensionPreview": {
      "$ref": "#/$defs/ExtensionPreviewPayload"
    },
    "slashCommandInput": {
      "$ref": "#/$defs/SlashCommandInvokeInput"
    },
    "slashCommandResult": {
      "$ref": "#/$defs/SlashCommandInvokeResult"
    }
  },
  "required": [
    "envelope",
    "actionCatalog",
    "actionInvoke",
    "slashCommandInput",
    "slashCommandResult",
    "extensionList",
    "extensionDetail",
    "extensionPreview"
  ],
  "title": "ClientContractBundle",
  "type": "object"
}
