        <mxCell id="intent" value="&lt;div style=&quot;line-height:1.28;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.5px;color:#FF9C97;&quot;&gt;MODEL INTENT&lt;/div&gt;&lt;div style=&quot;font-size:25px;font-weight:700;color:#FFFFFF;margin-top:10px;&quot;&gt;Proposed action&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#D5D8DA;background:#25282C;border:1px solid #3B3F44;border-radius:7px;padding:12px;margin-top:24px;&quot;&gt;Write the report&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#D5D8DA;background:#25282C;border:1px solid #3B3F44;border-radius:7px;padding:12px;margin-top:9px;&quot;&gt;Run a command&lt;/div&gt;&lt;div style=&quot;font-size:15px;color:#D5D8DA;background:#25282C;border:1px solid #3B3F44;border-radius:7px;padding:12px;margin-top:9px;&quot;&gt;Call a Tool&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#AEB5BB;margin-top:23px;&quot;&gt;A request is not authority.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17191C;strokeColor=#17191C;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=25;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1">
