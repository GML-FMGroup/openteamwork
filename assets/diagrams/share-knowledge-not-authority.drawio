        <mxCell id="footer" value="NO UNIVERSAL MEMORY POOL. KNOWLEDGE MOVES ONLY THROUGH POLICY." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#4F555B;" vertex="1" parent="1"><mxGeometry x="60" y="716" width="800" height="28" as="geometry" /></mxCell>
