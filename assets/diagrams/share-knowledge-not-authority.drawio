        <mxCell id="accent" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E6534E;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="60" y="54" width="44" height="5" as="geometry" /></mxCell>
        <mxCell id="title" value="KNOWLEDGE IS SHARED. AUTHORITY IS NOT." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontStyle=1;fontColor=#17191C;" vertex="1" parent="1"><mxGeometry x="60" y="68" width="960" height="48" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="A higher-privilege Agent can search permitted retained work without inheriting the target Agent's permissions." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#69717A;" vertex="1" parent="1"><mxGeometry x="60" y="122" width="980" height="44" as="geometry" /></mxCell>
        <mxCell id="figure-label" value="02 / PERMISSION-AWARE KNOWLEDGE" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#8A9096;" vertex="1" parent="1"><mxGeometry x="1070" y="72" width="310" height="28" as="geometry" /></mxCell>

        <mxCell id="requester" value="&lt;div style=&quot;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.5px;color:#5F806B;&quot;&gt;REQUESTING AGENT&lt;/div&gt;&lt;div style=&quot;font-size:24px;font-weight:700;color:#17191C;margin-top:8px;&quot;&gt;Agent / High&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#69717A;margin-top:8px;&quot;&gt;Trusted owner + Agent identity&lt;br&gt;Effective privilege pinned to Runtime&lt;/div&gt;&lt;div style=&quot;font-size:12px;letter-spacing:1.2px;color:#5F806B;margin-top:28px;&quot;&gt;SEARCH REQUEST&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:700;color:#17191C;background:#FFFFFF;border:1px solid #AFC8B7;border-radius:7px;padding:13px;margin-top:7px;&quot;&gt;“Find the earlier policy research”&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7F1EB;strokeColor=#78A087;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=26;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="320" height="330" as="geometry" /></mxCell>
        <mxCell id="gate" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.5px;color:#B33E39;&quot;&gt;OPEN TEAMWORK NODE&lt;/div&gt;&lt;div style=&quot;font-size:24px;font-weight:700;color:#17191C;margin-top:7px;&quot;&gt;Knowledge access decision&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#69717A;margin-top:8px;&quot;&gt;Scope comes from trusted Runtime facts—not the model.&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#17191C;background:#F7F6F2;border:1px solid #DEDAD2;border-radius:6px;padding:10px 13px;margin-top:18px;&quot;&gt;01&#160;&#160;Same owner&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#17191C;background:#F7F6F2;border:1px solid #DEDAD2;border-radius:6px;padding:10px 13px;margin-top:8px;&quot;&gt;02&#160;&#160;Requester privilege ≥ target privilege&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#17191C;background:#F7F6F2;border:1px solid #DEDAD2;border-radius:6px;padding:10px 13px;margin-top:8px;&quot;&gt;03&#160;&#160;Exact target Agent + owner scope&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#17191C;background:#FDE9E7;border:1px solid #E8AAA6;border-radius:6px;padding:10px 13px;margin-top:8px;&quot;&gt;04&#160;&#160;Durable cross-Agent audit&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#B33E39;margin-top:15px;&quot;&gt;Audit unavailable → deny access.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E6534E;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=24;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="210" width="440" height="390" as="geometry" /></mxCell>
        <mxCell id="target" value="&lt;div style=&quot;line-height:1.24;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.4px;color:#6E7F8C;&quot;&gt;PERMITTED TARGET&lt;/div&gt;&lt;div style=&quot;font-size:24px;font-weight:700;color:#17191C;margin-top:8px;&quot;&gt;Agent / Medium&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#69717A;margin-top:8px;&quot;&gt;Same owner · lower privilege&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#17191C;background:#E9EEF2;border:1px solid #96A8B7;border-radius:7px;padding:13px;margin-top:24px;&quot;&gt;RETAINED SESSIONS&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#17191C;background:#E9EEF2;border:1px solid #96A8B7;border-radius:7px;padding:13px;margin-top:10px;&quot;&gt;SEARCHED MESSAGE HISTORY&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#355A43;background:#E7F1EB;border:1px solid #78A087;border-radius:7px;padding:12px;margin-top:18px;&quot;&gt;&lt;b&gt;Returns:&lt;/b&gt; authorized excerpts + stable citations&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#96A8B7;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=25;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="240" width="320" height="330" as="geometry" /></mxCell>

        <mxCell id="cross-user-note" value="&lt;div style=&quot;font-size:11px;letter-spacing:1.2px;color:#B33E39;&quot;&gt;CROSS-USER RULE&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#4F555B;margin-top:5px;&quot;&gt;Source user + source Agent must be high/root. Root targets remain protected.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE9E7;strokeColor=#E8AAA6;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="622" width="860" height="64" as="geometry" /></mxCell>
        <mxCell id="edge-request" value="SEARCH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E6534E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#B33E39;labelBackgroundColor=#F7F6F2;" edge="1" parent="1" source="requester" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
