        <mxCell id="clients" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.4px;color:#6E7F8C;&quot;&gt;01 / 用户 + 客户端&lt;/div&gt;&lt;div style=&quot;font-size:21px;font-weight:700;color:#17191C;margin-top:7px;&quot;&gt;多个已认证用户&lt;/div&gt;&lt;div style=&quot;margin-top:12px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#586A77;background:#FFFFFF;border:1px solid #C7D1D8;border-radius:12px;padding:7px 13px;&quot;&gt;DESKTOP&lt;/span&gt;&amp;#160;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#586A77;background:#FFFFFF;border:1px solid #C7D1D8;border-radius:12px;padding:7px 13px;&quot;&gt;CLI&lt;/span&gt;&amp;#160;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#586A77;background:#FFFFFF;border:1px solid #C7D1D8;border-radius:12px;padding:7px 13px;&quot;&gt;未来客户端&lt;/span&gt;&amp;#160;&amp;#160;&lt;span style=&quot;font-size:12px;color:#69717A;&quot;&gt;共享类型化 Client Contract · HTTP/SSE · Actions&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9EEF2;strokeColor=#96A8B7;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=18;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="1080" height="110" as="geometry" /></mxCell>

        <mxCell id="node" value="&lt;div style=&quot;line-height:1.18;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.5px;color:#FF9C97;&quot;&gt;02 / 中央 OPENTEAMWORK NODE&lt;/div&gt;&lt;div style=&quot;font-size:22px;font-weight:700;color:#FFFFFF;margin-top:7px;&quot;&gt;身份、权限、生命周期与证据的唯一事实源&lt;/div&gt;&lt;div style=&quot;margin-top:16px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:11px;padding:7px 10px;&quot;&gt;身份 + SESSIONS&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:11px;padding:7px 10px;&quot;&gt;AGENT 注册表&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:11px;padding:7px 10px;&quot;&gt;MODEL PROFILES + 密钥&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:14px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#3A2425;border:1px solid #7B3C3A;border-radius:11px;padding:7px 10px;&quot;&gt;权限编译器&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:11px;padding:7px 10px;&quot;&gt;扩展生命周期&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:11px;padding:7px 10px;&quot;&gt;运维 + 审计&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17191C;strokeColor=#17191C;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=20;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="1080" height="170" as="geometry" /></mxCell>

        <mxCell id="runtime" value="&lt;div style=&quot;line-height:1.18;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.4px;color:#5F806B;&quot;&gt;03 / 不可变 AGENT RUNTIME + GOOGLE ADK&lt;/div&gt;&lt;div style=&quot;font-size:21px;font-weight:700;color:#17191C;margin-top:7px;&quot;&gt;每个 Agent 都以固定的身份、权限与扩展快照运行&lt;/div&gt;&lt;div style=&quot;margin-top:14px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#355A43;background:#DDECE2;border-radius:11px;padding:7px 11px;&quot;&gt;AGENT / HIGH&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#586A77;background:#E2E9EE;border-radius:11px;padding:7px 11px;&quot;&gt;AGENT / MEDIUM&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#6C6557;background:#EFE9DB;border-radius:11px;padding:7px 11px;&quot;&gt;AGENT / LOW&lt;/span&gt;&amp;#160;&amp;#160;&lt;span style=&quot;font-size:12px;color:#69717A;&quot;&gt;Runner · Session · Artifact · Memory · Skills · Apps · MCP · Plugins&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7F1EB;strokeColor=#78A087;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=20;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="1080" height="140" as="geometry" /></mxCell>

        <mxCell id="enforcement" value="&lt;div style=&quot;line-height:1.18;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.4px;color:#B33E39;&quot;&gt;04 / 执行策略边界&lt;/div&gt;&lt;div style=&quot;margin-top:13px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#17191C;background:#FFFFFF;border:1px solid #E8AAA6;border-radius:11px;padding:8px 11px;&quot;&gt;文件 + 路径&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#17191C;background:#FFFFFF;border:1px solid #E8AAA6;border-radius:11px;padding:8px 11px;&quot;&gt;命令 + 进程&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#17191C;background:#FFFFFF;border:1px solid #E8AAA6;border-radius:11px;padding:8px 11px;&quot;&gt;网络&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#17191C;background:#FFFFFF;border:1px solid #E8AAA6;border-radius:11px;padding:8px 11px;&quot;&gt;TOOLS + ACTIONS&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#17191C;background:#FFFFFF;border:1px solid #E8AAA6;border-radius:11px;padding:8px 11px;&quot;&gt;APP + MCP + SKILL&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#B33E39;margin-top:14px;&quot;&gt;拒绝优先 · 在副作用边界重新检查 · 保护不可用 → 停止&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE9E7;strokeColor=#E6534E;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=18;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="1080" height="120" as="geometry" /></mxCell>

        <mxCell id="resources" value="&lt;div style=&quot;line-height:1.18;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.4px;color:#8E7543;&quot;&gt;05 / 受控资源 + 系统&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#6C6557;background:#F3EDDF;border:1px solid #B89C65;border-radius:11px;padding:8px 11px;&quot;&gt;AGENT 工作区&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#6C6557;background:#F3EDDF;border:1px solid #B89C65;border-radius:11px;padding:8px 11px;&quot;&gt;受保护 NODE 数据&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#6C6557;background:#F3EDDF;border:1px solid #B89C65;border-radius:11px;padding:8px 11px;&quot;&gt;DOCKER 进程&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#6C6557;background:#F3EDDF;border:1px solid #B89C65;border-radius:11px;padding:8px 11px;&quot;&gt;网络服务&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:14px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#586A77;background:#E9EEF2;border:1px solid #96A8B7;border-radius:11px;padding:8px 11px;&quot;&gt;企业 APPS + TOOLS&lt;/span&gt;&amp;#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#586A77;background:#E9EEF2;border:1px solid #96A8B7;border-radius:11px;padding:8px 11px;&quot;&gt;历史 SESSIONS + ARTIFACTS&lt;/span&gt;&amp;#160;&amp;#160;&lt;span style=&quot;font-size:12px;color:#69717A;&quot;&gt;密钥仅在最终 Provider 或连接边界解析。&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B89C65;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=19;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="1080" height="130" as="geometry" /></mxCell>

        <mxCell id="evidence" value="&lt;div style=&quot;line-height:1.22;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.4px;color:#FF9C97;&quot;&gt;持久证据&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:700;color:#FFFFFF;margin-top:8px;&quot;&gt;发生了什么，以及为什么&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:6px;padding:10px;margin-top:20px;&quot;&gt;身份&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#E6534E;text-align:center;margin:4px;&quot;&gt;↓&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:6px;padding:10px;&quot;&gt;策略决策&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#E6534E;text-align:center;margin:4px;&quot;&gt;↓&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:6px;padding:10px;&quot;&gt;执行结果&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#E6534E;text-align:center;margin:4px;&quot;&gt;↓&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#3A2425;border:1px solid #7B3C3A;border-radius:6px;padding:10px;&quot;&gt;审计 + 用量 + ARTIFACTS&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#AEB5BB;margin-top:18px;&quot;&gt;普通审计投影不包含 Prompt、回复与密钥值。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17191C;strokeColor=#17191C;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=22;spacingLeft=18;spacingRight=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1180" y="320" width="200" height="430" as="geometry" /></mxCell>

