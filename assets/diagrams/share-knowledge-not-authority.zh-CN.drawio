        <mxCell id="title" value="共享知识，不共享权限。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=30;fontStyle=1;fontColor=#17191C;" vertex="1" parent="1"><mxGeometry x="60" y="68" width="960" height="48" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="高权限 Agent 可以检索获准的历史工作，但不会继承目标 Agent 的权限。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#69717A;" vertex="1" parent="1"><mxGeometry x="60" y="122" width="980" height="44" as="geometry" /></mxCell>
        <mxCell id="figure-label" value="02 / 权限感知的知识访问" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#8A9096;" vertex="1" parent="1"><mxGeometry x="1070" y="72" width="310" height="28" as="geometry" /></mxCell>

        <mxCell id="requester" value="&lt;div style=&quot;line-height:1.25;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.5px;color:#5F806B;&quot;&gt;请求方 AGENT&lt;/div&gt;&lt;div style=&quot;font-size:24px;font-weight:700;color:#17191C;margin-top:8px;&quot;&gt;Agent / High&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#69717A;margin-top:8px;&quot;&gt;可信所有者 + Agent 身份&lt;br&gt;有效权限固定在 Runtime 中&lt;/div&gt;&lt;div style=&quot;font-size:12px;letter-spacing:1.2px;color:#5F806B;margin-top:28px;&quot;&gt;检索请求&lt;/div&gt;&lt;div style=&quot;font-size:16px;font-weight:700;color:#17191C;background:#FFFFFF;border:1px solid #AFC8B7;border-radius:7px;padding:13px;margin-top:7px;&quot;&gt;“查找之前的政策调研”&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7F1EB;strokeColor=#78A087;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=26;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="320" height="330" as="geometry" /></mxCell>
        <mxCell id="gate" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.5px;color:#B33E39;&quot;&gt;OPENTEAMWORK NODE&lt;/div&gt;&lt;div style=&quot;font-size:24px;font-weight:700;color:#17191C;margin-top:7px;&quot;&gt;知识访问决策&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#69717A;margin-top:8px;&quot;&gt;范围由可信 Runtime 事实决定，而不是模型。&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#17191C;background:#F7F6F2;border:1px solid #DEDAD2;border-radius:6px;padding:10px 13px;margin-top:18px;&quot;&gt;01&amp;#160;&amp;#160;同一所有者&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#17191C;background:#F7F6F2;border:1px solid #DEDAD2;border-radius:6px;padding:10px 13px;margin-top:8px;&quot;&gt;02&amp;#160;&amp;#160;请求方权限 ≥ 目标权限&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#17191C;background:#F7F6F2;border:1px solid #DEDAD2;border-radius:6px;padding:10px 13px;margin-top:8px;&quot;&gt;03&amp;#160;&amp;#160;精确目标 Agent + 所有者范围&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#17191C;background:#FDE9E7;border:1px solid #E8AAA6;border-radius:6px;padding:10px 13px;margin-top:8px;&quot;&gt;04&amp;#160;&amp;#160;持久化跨 Agent 审计&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#B33E39;margin-top:15px;&quot;&gt;审计不可用 → 拒绝访问。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E6534E;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=24;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="210" width="440" height="390" as="geometry" /></mxCell>
        <mxCell id="target" value="&lt;div style=&quot;line-height:1.24;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.4px;color:#6E7F8C;&quot;&gt;获准目标&lt;/div&gt;&lt;div style=&quot;font-size:24px;font-weight:700;color:#17191C;margin-top:8px;&quot;&gt;Agent / Medium&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#69717A;margin-top:8px;&quot;&gt;同一所有者 · 较低权限&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#17191C;background:#E9EEF2;border:1px solid #96A8B7;border-radius:7px;padding:13px;margin-top:24px;&quot;&gt;历史 SESSIONS&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#17191C;background:#E9EEF2;border:1px solid #96A8B7;border-radius:7px;padding:13px;margin-top:10px;&quot;&gt;已检索的消息历史&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#355A43;background:#E7F1EB;border:1px solid #78A087;border-radius:7px;padding:12px;margin-top:18px;&quot;&gt;&lt;b&gt;返回：&lt;/b&gt;获准摘录 + 稳定引用&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#96A8B7;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=25;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="240" width="320" height="330" as="geometry" /></mxCell>

        <mxCell id="cross-user-note" value="&lt;div style=&quot;font-size:11px;letter-spacing:1.2px;color:#B33E39;&quot;&gt;跨用户规则&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#4F555B;margin-top:5px;&quot;&gt;来源用户与来源 Agent 均须为 high/root。root 目标始终受保护。&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE9E7;strokeColor=#E8AAA6;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="622" width="860" height="64" as="geometry" /></mxCell>
        <mxCell id="edge-request" value="检索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E6534E;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#B33E39;labelBackgroundColor=#F7F6F2;" edge="1" parent="1" source="requester" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge-query" value="获准查询" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#78A087;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=10;fontStyle=1;fontColor=#446B53;labelBackgroundColor=#F7F6F2;" edge="1" parent="1" source="gate" target="target"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="return-pill" value="&lt;div style=&quot;font-size:10px;letter-spacing:1.2px;color:#5F806B;&quot;&gt;返回请求方&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#355A43;margin-top:5px;&quot;&gt;引用知识，而非目标权限&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7F1EB;strokeColor=#78A087;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="622" width="420" height="64" as="geometry" /></mxCell>
