        <mxCell id="footer" value="不存在全局 MEMORY 池；知识只能经由策略流动。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#4F555B;" vertex="1" parent="1"><mxGeometry x="60" y="716" width="800" height="28" as="geometry" /></mxCell>
        <mxCell id="footer-brand" value="OPENTEAMWORK" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#E6534E;" vertex="1" parent="1"><mxGeometry x="1190" y="716" width="190" height="28" as="geometry" /></mxCell>
