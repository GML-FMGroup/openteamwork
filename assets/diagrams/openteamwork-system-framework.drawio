        <mxCell id="clients" value="&lt;div style=&quot;line-height:1.2;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.4px;color:#6E7F8C;&quot;&gt;01 / PEOPLE + CLIENTS&lt;/div&gt;&lt;div style=&quot;font-size:21px;font-weight:700;color:#17191C;margin-top:7px;&quot;&gt;Multiple authenticated users&lt;/div&gt;&lt;div style=&quot;margin-top:12px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#586A77;background:#FFFFFF;border:1px solid #C7D1D8;border-radius:12px;padding:7px 13px;&quot;&gt;DESKTOP&lt;/span&gt;&#160;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#586A77;background:#FFFFFF;border:1px solid #C7D1D8;border-radius:12px;padding:7px 13px;&quot;&gt;CLI&lt;/span&gt;&#160;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#586A77;background:#FFFFFF;border:1px solid #C7D1D8;border-radius:12px;padding:7px 13px;&quot;&gt;FUTURE CLIENTS&lt;/span&gt;&#160;&#160;&lt;span style=&quot;font-size:12px;color:#69717A;&quot;&gt;Shared typed Client Contract · HTTP/SSE · Actions&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9EEF2;strokeColor=#96A8B7;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=18;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="1080" height="110" as="geometry" /></mxCell>

        <mxCell id="node" value="&lt;div style=&quot;line-height:1.18;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.5px;color:#FF9C97;&quot;&gt;02 / CENTRAL OPEN TEAMWORK NODE&lt;/div&gt;&lt;div style=&quot;font-size:22px;font-weight:700;color:#FFFFFF;margin-top:7px;&quot;&gt;Source of truth for identity, authority, lifecycle and evidence&lt;/div&gt;&lt;div style=&quot;margin-top:16px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:11px;padding:7px 10px;&quot;&gt;IDENTITY + SESSIONS&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:11px;padding:7px 10px;&quot;&gt;AGENT REGISTRY&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:11px;padding:7px 10px;&quot;&gt;MODEL PROFILES + SECRETS&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:14px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#3A2425;border:1px solid #7B3C3A;border-radius:11px;padding:7px 10px;&quot;&gt;PERMISSION COMPILER&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:11px;padding:7px 10px;&quot;&gt;EXTENSION LIFECYCLE&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:11px;padding:7px 10px;&quot;&gt;OPERATIONS + AUDIT&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17191C;strokeColor=#17191C;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=20;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="1080" height="170" as="geometry" /></mxCell>

        <mxCell id="runtime" value="&lt;div style=&quot;line-height:1.18;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.4px;color:#5F806B;&quot;&gt;03 / IMMUTABLE AGENT RUNTIMES + GOOGLE ADK&lt;/div&gt;&lt;div style=&quot;font-size:21px;font-weight:700;color:#17191C;margin-top:7px;&quot;&gt;Each Agent runs with pinned identity, permission and extension snapshots&lt;/div&gt;&lt;div style=&quot;margin-top:14px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#355A43;background:#DDECE2;border-radius:11px;padding:7px 11px;&quot;&gt;AGENT / HIGH&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#586A77;background:#E2E9EE;border-radius:11px;padding:7px 11px;&quot;&gt;AGENT / MEDIUM&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#6C6557;background:#EFE9DB;border-radius:11px;padding:7px 11px;&quot;&gt;AGENT / LOW&lt;/span&gt;&#160;&#160;&lt;span style=&quot;font-size:12px;color:#69717A;&quot;&gt;Runner · Session · Artifact · Memory · Skills · Apps · MCP · Plugins&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7F1EB;strokeColor=#78A087;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=20;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="1080" height="140" as="geometry" /></mxCell>

        <mxCell id="enforcement" value="&lt;div style=&quot;line-height:1.18;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.4px;color:#B33E39;&quot;&gt;04 / EXECUTION POLICY BOUNDARY&lt;/div&gt;&lt;div style=&quot;margin-top:13px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#17191C;background:#FFFFFF;border:1px solid #E8AAA6;border-radius:11px;padding:8px 11px;&quot;&gt;FILES + PATHS&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#17191C;background:#FFFFFF;border:1px solid #E8AAA6;border-radius:11px;padding:8px 11px;&quot;&gt;COMMANDS + PROCESSES&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#17191C;background:#FFFFFF;border:1px solid #E8AAA6;border-radius:11px;padding:8px 11px;&quot;&gt;NETWORK&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#17191C;background:#FFFFFF;border:1px solid #E8AAA6;border-radius:11px;padding:8px 11px;&quot;&gt;TOOLS + ACTIONS&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#17191C;background:#FFFFFF;border:1px solid #E8AAA6;border-radius:11px;padding:8px 11px;&quot;&gt;APP + MCP + SKILL&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#B33E39;margin-top:14px;&quot;&gt;Deny precedence · recheck at side-effect boundaries · protection unavailable → stop&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDE9E7;strokeColor=#E6534E;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=18;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="1080" height="120" as="geometry" /></mxCell>

        <mxCell id="resources" value="&lt;div style=&quot;line-height:1.18;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.4px;color:#8E7543;&quot;&gt;05 / CONTROLLED RESOURCES + SYSTEMS&lt;/div&gt;&lt;div style=&quot;margin-top:15px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#6C6557;background:#F3EDDF;border:1px solid #B89C65;border-radius:11px;padding:8px 11px;&quot;&gt;AGENT WORKSPACES&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#6C6557;background:#F3EDDF;border:1px solid #B89C65;border-radius:11px;padding:8px 11px;&quot;&gt;PROTECTED NODE DATA&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#6C6557;background:#F3EDDF;border:1px solid #B89C65;border-radius:11px;padding:8px 11px;&quot;&gt;DOCKER PROCESSES&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#6C6557;background:#F3EDDF;border:1px solid #B89C65;border-radius:11px;padding:8px 11px;&quot;&gt;NETWORK SERVICES&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:14px;&quot;&gt;&lt;span style=&quot;font-size:12px;font-weight:700;color:#586A77;background:#E9EEF2;border:1px solid #96A8B7;border-radius:11px;padding:8px 11px;&quot;&gt;ENTERPRISE APPS + TOOLS&lt;/span&gt;&#160;&lt;span style=&quot;font-size:12px;font-weight:700;color:#586A77;background:#E9EEF2;border:1px solid #96A8B7;border-radius:11px;padding:8px 11px;&quot;&gt;RETAINED SESSIONS + ARTIFACTS&lt;/span&gt;&#160;&#160;&lt;span style=&quot;font-size:12px;color:#69717A;&quot;&gt;Secrets resolve only at the final provider or connection boundary.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B89C65;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=19;spacingLeft=24;spacingRight=24;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="1080" height="130" as="geometry" /></mxCell>

        <mxCell id="evidence" value="&lt;div style=&quot;line-height:1.22;&quot;&gt;&lt;div style=&quot;font-size:11px;letter-spacing:1.4px;color:#FF9C97;&quot;&gt;DURABLE EVIDENCE&lt;/div&gt;&lt;div style=&quot;font-size:19px;font-weight:700;color:#FFFFFF;margin-top:8px;&quot;&gt;What happened—and why&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:6px;padding:10px;margin-top:20px;&quot;&gt;IDENTITY&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#E6534E;text-align:center;margin:4px;&quot;&gt;↓&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:6px;padding:10px;&quot;&gt;POLICY DECISION&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#E6534E;text-align:center;margin:4px;&quot;&gt;↓&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#25282C;border:1px solid #3B3F44;border-radius:6px;padding:10px;&quot;&gt;EXECUTION OUTCOME&lt;/div&gt;&lt;div style=&quot;font-size:10px;color:#E6534E;text-align:center;margin:4px;&quot;&gt;↓&lt;/div&gt;&lt;div style=&quot;font-size:12px;font-weight:700;color:#FFFFFF;background:#3A2425;border:1px solid #7B3C3A;border-radius:6px;padding:10px;&quot;&gt;AUDIT + USAGE + ARTIFACTS&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#AEB5BB;margin-top:18px;&quot;&gt;Prompts, responses and secret values stay out of ordinary audit projections.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17191C;strokeColor=#17191C;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=22;spacingLeft=18;spacingRight=18;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1180" y="320" width="200" height="430" as="geometry" /></mxCell>

